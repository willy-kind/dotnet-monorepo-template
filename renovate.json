{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": ["xunit*", "Microsoft.NET.Test.Sdk", "coverlet*"],
      "groupName": "test packages"
    }
  ]
}
